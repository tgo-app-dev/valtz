<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- libvpipe dlopens FFmpeg and vpipe plugins, which are not signed by
       our team. Same choice as vpipe's own app. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Peers: Valtz servers on other Macs (Bonjour + TLS). -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- A microphone recorded into an audio asset (hardened runtime). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- A photo or a video taken with the camera (hardened runtime). -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
