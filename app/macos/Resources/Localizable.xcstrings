          }
        }
      }
    },
    "The model that writes prompts with you, reads what you ask for and watches your clips: which one, and how it runs." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "与你一起写提示词、理解你的要求并观看你的视频的模型：用哪一个，以及如何运行。"
          }
        }
      }
    },
    "The model's few-step LoRA: turned on or off, the steps are its preset's" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
