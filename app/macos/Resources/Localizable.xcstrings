    },
    "A semitone lower" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "降低一个半音"
          }
        }
      }
    },
    "A shorter clip" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "更短的视频"
          }
        }
      }
    },
    "A smaller size" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "更小的尺寸"
          }
        }
      }
    },
    "A sound (or a clip) in the prompt is the voice: up to its first 12 seconds are cloned" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "提示中的声音（或视频）就是嗓音：克隆其最多前 12 秒"
          }
        }
      }
    },
    "A task withheld is not offered: the members run it themselves or send it to another member." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "不共享的任务不会提供给其他成员：它们会自己运行，或交给另一个成员。"
          }
        }
      }
    },
    "AAC (.m4a)" : {
      "localizations" : {
        "zh-Hans" : {
