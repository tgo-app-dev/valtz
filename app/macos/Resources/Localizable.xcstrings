        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文字"
          }
        }
      }
    },
    "Text does not go on the stage: put it in the prompt." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文本不能放到舞台上：请放入提示词。"
          }
        }
      }
    },
    "Text does not go on the timeline: put it in the prompt." : {
      "localizations" : {
